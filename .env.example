# Railway supplies DATABASE_URL when PostgreSQL is attached.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
SITE_URL=https://www.expertsgp.com
# First admin is provisioned as the owner on first boot. Change these before deploy.
ADMIN_EMAIL=admin@your-company.com
ADMIN_PASSWORD=Replace-With-A-Strong-Unique-Password-123!
PORT=3000
